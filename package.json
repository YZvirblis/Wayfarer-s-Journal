{
  "name": "wayfarers-journal",
  "version": "1.0.0",
  "private": true,
  "description": "A local, open-source journal and character tracker for roleplayers.",
  "license": "MIT",
  "author": "Yuriy Zvirblis",
  "homepage": "https://github.com/YZvirblis/Wayfarer-s-Journal",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:electron": "vite build --config vite.electron.config.ts",
    "icon": "electron scripts/make-icon.cjs",
    "electron:dev": "npm run build && npm run build:electron && npm run icon && electron .",
    "electron:build": "npm run build && npm run build:electron && npm run icon && electron-builder --win portable",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@fontsource-variable/cinzel": "^5.2.5",
    "@fontsource-variable/eb-garamond": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "dev.yuriyz.wayfarers-journal",
    "productName": "Wayfarer's Journal",
    "copyright": "MIT — Yuriy Zvirblis",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "examples/**",
      "electron/preload.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "Wayfarers-Journal-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "Wayfarers-Journal-${version}-portable.exe"
    }
  }
}
